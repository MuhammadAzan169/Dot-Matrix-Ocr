# Static frontend image, for local preview and any non-Vercel host.
# Vercel does not use this file — it serves the directory directly.
#
#   docker build --build-arg API_BASE_URL=http://localhost:10000 -t ocr-web .
#
# Stage 1 bakes the config the same way Vercel's build command does, so the
# container and the deployment are generated by identical code.
FROM node:20-alpine AS config

ARG API_BASE_URL=""
ARG WAKE_BACKEND="true"
ARG MAX_UPLOAD_MB="10"
ENV API_BASE_URL=$API_BASE_URL \
    WAKE_BACKEND=$WAKE_BACKEND \
    MAX_UPLOAD_MB=$MAX_UPLOAD_MB

WORKDIR /build
COPY generate-config.js .
RUN node generate-config.js

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY index.html styles.css script.js /usr/share/nginx/html/
COPY samples/ /usr/share/nginx/html/samples/
COPY --from=config /build/config.js /usr/share/nginx/html/config.js

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s \
    CMD wget -qO- http://localhost:8080/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
