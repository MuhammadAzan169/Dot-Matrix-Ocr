# ---------------------------------------------------------------------------
# Frontend configuration
# ---------------------------------------------------------------------------
# This is a static site, so there is no server to read these at runtime.
# `node generate-config.js` bakes them into config.js, which the page loads.
# Vercel runs that generator as its build command, reading the same variable
# names from the project's Environment Variables settings.
# ---------------------------------------------------------------------------

# Base URL of the backend API, no trailing slash.
#   production : https://dot-matrix-ocr-api.onrender.com
#   local      : leave EMPTY to call the same origin — correct when the root
#                app.py launcher serves the UI and the API together.
API_BASE_URL=

# Show a "waking the server up" hint while a sleeping Render free instance
# cold-starts (~50s). Pointless locally, where there is no cold start.
WAKE_BACKEND=true

# Largest image the UI will attempt to upload, in megabytes.
MAX_UPLOAD_MB=10
