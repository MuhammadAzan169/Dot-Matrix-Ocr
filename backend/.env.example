# ---- Required ----
# OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional extra keys. Free OpenRouter keys are rate-limited one by one, so the
# server rotates through every key it finds before waiting. Number them from 1;
# they are tried in numeric order after the unnumbered key above.
#   OPENROUTER_API_KEY1=sk-or-v1-...
#   OPENROUTER_API_KEY2=sk-or-v1-...

# ---- Optional ----
# Vision model used for the final OCR read. Must accept images AND return plain
# text. Avoid "openrouter/free" as the primary: it routes to a random free model
# per call, including classifiers and reasoning models that return no content.
OCR_MODEL=google/gemma-4-31b-it:free

# Tried in order when the primary fails or is rate-limited.
OCR_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,openrouter/free

# Comma-separated list of origins allowed to call this API.
# In production set this to your Vercel URLs, e.g.
#   ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-git-main-you.vercel.app
ALLOWED_ORIGINS=*

# Port. Render sets this automatically; only matters locally.
PORT=10000

# Set to 1 to keep intermediate images on disk for debugging.
KEEP_UPLOADS=0
