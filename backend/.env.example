# ---- Required ----
# OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ---- Optional ----
# Vision model used for the final OCR read.
OCR_MODEL=openrouter/free

# Comma-separated list of origins allowed to call this API.
# In production set this to your Vercel URLs, e.g.
#   ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-git-main-you.vercel.app
ALLOWED_ORIGINS=*

# Port. Render sets this automatically; only matters locally.
PORT=10000

# Set to 1 to keep intermediate images on disk for debugging.
KEEP_UPLOADS=0
